      :host {
        --md-icon-fill: 1;
        display: inline-flex;
        isolation: isolate;
      }

      :host([type=3D'toggle']:not([selected])) {
        --md-icon-fill: 0;
      }

      :host([type=3D'toggle'][selected]) {
        --md-icon-fill: 1;
      }

      /*
       * A selected toggle whose icon has no filled version gets a semibold
       * icon instead of a filled one (buttons.md Toggle buttons).
       */
      :host([type=3D'toggle'][selected][unfilled-icon]) {
        --md-icon-fill: 0;
        --md-icon-wght: 600;
      }

      .btn {
        flex: 1;
        position: relative;
      }
      .btn:has([name=3D'container'].has-slotted) {
        background-color: transparent;
      }
      slot[name=3D'container'] {
        display: block;
        position: absolute;
        inset: 0;
        border-radius: inherit;
        pointer-events: none;
        --color: var(--container-color);
        z-index: -1;
        transition: inherit;
      }
      slot[name=3D'container']::slotted(*) {
        width: 100%;
        height: 100%;
      }
    

