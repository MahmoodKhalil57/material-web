  padding-inline: var(--md-sys-space-150);
  border-radius: var(--md-sys-shape-corner-full);
  background: var(--md-sys-color-surface-container-highest);
  color: var(--md-sys-color-on-surface-variant);
  font: var(--md-sys-typescale-label-md);
  font-variation-settings: var(--md-sys-typescale-label-md-axes);
}
.gb-compat-chip md-gb-icon {
  --md-icon-size: 16px;
  color: var(--md-sys-color-primary);
}
.gb-compat-chevron {
  flex: none;
  color: var(--md-sys-color-on-surface-variant);
}
@media (prefers-reduced-motion: no-preference) {
  .gb-compat-chevron {
    transition: rotate var(--md-sys-motion-spring-fast-spatial-duration) va=
r(--md-sys-motion-spring-fast-spatial);
  }
}
.gb-compat-row[open] .gb-compat-chevron {
  rotate: 180deg;
}
.gb-compat-body {
  padding: 0 var(--md-sys-space-200) var(--md-sys-space-200) calc(var(--md-=
sys-space-200) + 44px + var(--md-sys-space-150));
  color: var(--md-sys-color-on-surface);
}
.gb-compat-body p {
  margin: var(--md-sys-space-100) 0;
}
.gb-compat-list {
  margin: var(--md-sys-space-100) 0;
  padding-inline-start: var(--md-sys-space-250, 20px);
}
.gb-compat-list li {
  margin-block: var(--md-sys-space-50);
}
.gb-compat-tag {
  display: inline-block;
  padding: 0 var(--md-sys-space-75, 6px);
  border-radius: var(--md-sys-shape-corner-xs);
  font: var(--md-sys-typescale-label-sm);
  font-variation-settings: var(--md-sys-typescale-label-sm-axes);
  vertical-align: 1px;
}
.gb-compat-tag[data-status=3Dnewly] {
  background: var(--md-sys-color-tertiary-container);
  color: var(--md-sys-color-on-tertiary-container);
}
.gb-compat-tag[data-status=3Dlimited] {
  background: var(--md-sys-color-surface-container-highest);
