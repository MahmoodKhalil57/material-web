</tr>
<tr>
<td><code>fixed</code><br><span class=3D"gb-desc">Whether the snackbar shou=
ld be positioned relative to the viewport (fixed).</span></td>
<td><code>fixed</code></td>
<td><code>boolean</code></td>
<td><code>false</code></td>
</tr>
<tr>
<td><code>hasCloseButton</code><br><span class=3D"gb-desc">Whether to displ=
ay a close icon button.</span></td>
<td><code>has-close-button</code></td>
<td><code>boolean</code></td>
<td><code>false</code></td>
</tr>
<tr>
<td><code>labelText</code><br><span class=3D"gb-desc">Supporting message te=
xt to display. Rendered before default slot content.</span></td>
