}
.gb-compat-shape {
  position: absolute;
  inset: 0;
  inline-size: 100%;
  block-size: 100%;
  fill: var(--gb-compat-shape);
}
.gb-compat-logo-svg {
  position: relative;
  inline-size: 24px;
  block-size: 24px;
}
.gb-compat-logo[data-logo=3Dbaseline] .gb-compat-logo-svg {
  inline-size: 28px;
  block-size: 16px;
}
@media (prefers-reduced-motion: no-preference) {
  .gb-compat-shape {
    transition: rotate var(--md-sys-motion-spring-default-spatial-duration)=
 var(--md-sys-motion-spring-default-spatial);
  }
  .gb-compat-summary:hover .gb-compat-shape {
    rotate: 30deg;
