/* src/gb/navigation.css */
@view-transition {
  navigation: auto;
}
:root {
  --gb-vt-exit: 100ms;
  --gb-vt-enter: 200ms;
  --gb-vt-slide: 300ms;
  --gb-vt-shift: 30px;
}
:root:dir(rtl) {
  --gb-vt-shift: -30px;
}
@media (prefers-reduced-motion: reduce) {
  :root {
    --gb-vt-shift: 0px;
  }
}
.gb-content-pane {
  view-transition-name: gb-page;
  view-transition-class: page;
}
