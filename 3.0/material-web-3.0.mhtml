</tr>
<tr>
<td><code>md-filled-select</code></td>
<td><code>md-gb-select</code></td>
<td><code>menu-positioning</code>, <code>clamp-menu-width</code>, <code>men=
u-align</code> and <code>quick</code> dropped</td>
</tr>
<tr>
<td><code>md-outlined-select</code></td>
<td><code>md-gb-select</code></td>
