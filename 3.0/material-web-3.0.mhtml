/* src/gb/gb.css */
@font-face {
  font-family: "Roboto Flex Fallback";
  src:
    local("Arial"),
    local("Helvetica"),
    local("Liberation Sans");
  size-adjust: 99%;
  ascent-override: 92.8%;
