  }
  .gb-content pre,
  .gb-demo {
    break-inside: avoid;
  }
  .gb-rail-area,
  .gb-bar,
  .gb-top,
  .gb-toc,
  .gb-copy,
  .gb-skip,
  .gb-demo-toggle {
    display: none;
  }
  :root.js .gb-demo .gb-code {
    block-size: auto !important;
    mask-image: none !important;
  }
}
:root {
  interpolate-size: allow-keywords;
}
.gb-demo {
  margin: 0 0 var(--md-sys-space-200);
  border: 1px solid var(--md-sys-color-outline-variant);
  border-radius: var(--md-sys-shape-corner-lg);
  overflow: clip;
}
.gb-demo-preview,
.gb-content figure.gb-demo-figure {
  box-sizing: border-box;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: var(--md-sys-space-200);
  min-block-size: 12rem;
  margin: 0;
  padding: var(--md-sys-space-400);
  background: var(--md-sys-color-surface-container-lowest);
  color: var(--md-sys-color-on-surface);
}
.gb-content figure.gb-demo-figure {
  margin-block-end: var(--md-sys-space-200);
  border: 1px solid var(--md-sys-color-outline-variant);
  border-radius: var(--md-sys-shape-corner-lg);
}
.gb-demo-preview > .gb-example {
  inline-size: 100%;
}
.gb-demo-inline {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: var(--md-sys-space-200);
  inline-size: 100%;
}
.gb-demo-preview:has(> .gb-demo-inline) {
  min-block-size: var(--gb-demo-height, 12rem);
}
.gb-demo-inline > md-gb-carousel {
  inline-size: 100%;
}
md-gb-carousel:not(:defined) {
  display: block;
  block-size: var(--height, 221px);
  visibility: hidden;
}
md-gb-time-picker:not(:defined):not([modal]) {
  display: block;
  inline-size: 304px;
  block-size: 520px;
  visibility: hidden;
}
md-gb-time-picker:not(:defined)[density=3D"-1"]:not([modal]) {
  inline-size: 300px;
  block-size: 512px;
}
md-gb-time-picker:not(:defined)[density=3D"-2"]:not([modal]) {
  inline-size: 300px;
  block-size: 504px;
}
md-gb-time-picker:not(:defined)[density=3D"-3"]:not([modal]) {
  inline-size: 300px;
  block-size: 496px;
}
md-gb-time-picker:not(:defined)[orientation=3Dhorizontal]:not([modal]) {
  inline-size: 556px;
  block-size: 404px;
}
md-gb-time-picker:not(:defined)[mode=3Dinput]:not([modal]) {
  inline-size: 264px;
  block-size: 243px;
}
md-gb-time-picker:not(:defined)[mode=3Dinput][density=3D"-1"]:not([modal]) =
{
  block-size: 239px;
}
md-gb-time-picker:not(:defined)[mode=3Dinput][density=3D"-2"]:not([modal]) =
{
  block-size: 235px;
}
md-gb-time-picker:not(:defined)[mode=3Dinput][density=3D"-3"]:not([modal]) =
{
  block-size: 231px;
}
.gb-demo-preview[data-frame] {
  display: block;
  padding: 0;
  min-block-size: var(--gb-demo-height, 12rem);
}
.gb-demo-frame {
  display: block;
  inline-size: 100%;
  block-size: var(--gb-demo-height, 12rem);
  border: 0;
}
.gb-demo-tabs {
  min-block-size: 48px;
}
.gb-demo-tabs:not(:defined) {
  display: block;
  block-size: 48px;
  visibility: hidden;
}
.gb-demo-code {
  position: relative;
  border-block-start: 1px solid var(--md-sys-color-outline-variant);
  background: var(--md-sys-color-surface-container);
}
.gb-demo .gb-code {
  margin: 0;
  font: var(--md-sys-typescale-body-md);
  font-family:
    ui-monospace,
    "Roboto Mono",
    Menlo,
    Consolas,
    monospace;
}
.gb-demo pre {
  border-radius: 0;
  background: transparent;
  font: inherit;
}
:root.js .gb-demo:not([data-short]):not([data-open]) .gb-code {
  block-size: calc(3lh + 2 * var(--md-sys-space-200));
  overflow: hidden;
  mask-image:
    linear-gradient(
      to bottom,
      #000 35%,
      transparent);
}
:root.js .gb-demo:not([data-short])[data-open] .gb-code {
  block-size: auto;
}
:root.js .gb-demo:not([data-short]) .gb-code {
  transition: block-size var(--md-sys-motion-duration-medium2) var(--md-sys=
-motion-easing-emphasized);
}
.gb-demo-toggle {
  position: absolute;
  inset-inline: 0;
  inset-block-end: var(--md-sys-space-150);
  margin-inline: auto;
  inline-size: fit-content;
}
.gb-demo[data-open] .gb-demo-toggle {
  position: static;
  display: block;
  margin-block: 0 var(--md-sys-space-150);
}
.gb-demo-toggle:not(:defined) {
  visibility: hidden;
}
@media (prefers-reduced-motion: reduce) {
  :root.js .gb-demo:not([data-short]) .gb-code {
    transition: none;
  }
}
.gb-example {
  min-block-size: var(--gb-example-narrow-height, 0);
}
@media (min-width: 600px) {
  .gb-example {
    min-block-size: var(--gb-example-height, 0);
  }
}
.gb-content figure :not(:defined) {
  visibility: hidden;
}
@keyframes gb-skeleton-pulse {
  from {
    background-position: 100% 100%;
  }
  to {
    background-position: 0 0;
  }
}
.gb-demo-preview,
.gb-content figure.gb-demo-figure {
  position: relative;
}
.gb-demo-preview::after,
.gb-content figure.gb-demo-figure::after,
.gb-card-stage::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  background-color: var(--md-sys-color-surface-container);
  background-image:
    linear-gradient(
      135deg,
      transparent 40%,
      hsl(from var(--md-sys-color-on-surface) h s l / 6%) 50%,
      transparent 60%);
  background-size: 300% 300%;
  opacity: 0;
  transition: opacity var(--md-sys-motion-duration-short3, 150ms) linear;
}
:is(.gb-demo-preview, .gb-content figure.gb-demo-figure, .gb-card-stage):is=
(:has(:not(:defined)), :has(> .gb-demo-frame:not([data-ready])))::after {
  opacity: 1;
  animation: gb-skeleton-pulse 1.5s linear infinite;
}
@media (prefers-reduced-motion: reduce) {
  :is(.gb-demo-preview, .gb-content figure.gb-demo-figure, .gb-card-stage):=
:after {
    animation: none !important;
  }
}
