  --gb-compat-badge: var(--md-sys-color-error-container);
  --gb-compat-on-badge: var(--md-sys-color-on-error-container);
}
.gb-compat-row:is([data-state=3Dnone], [data-state=3Dinfo]) {
  --gb-compat-shape: var(--md-sys-color-surface-container-highest);
  --gb-compat-on-shape: var(--md-sys-color-on-surface-variant);
  --gb-compat-badge: var(--md-sys-color-surface-container-highest);
  --gb-compat-on-badge: var(--md-sys-color-on-surface-variant);
}
.gb-compat-logo {
  position: relative;
  display: grid;
  place-items: center;
  flex: none;
  inline-size: 44px;
  block-size: 44px;
