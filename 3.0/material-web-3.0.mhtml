        flex: 0 1 auto;
        max-inline-size: 100%;
        min-inline-size: 0;
      }

      :host([modal]) {
        display: contents;
      }

      :host([hidden]) {
        display: none;
      }

      :host([quick]) :is(.nav-drawer, .nav-drawer-scrim) {
        transition: none;
      }
    

