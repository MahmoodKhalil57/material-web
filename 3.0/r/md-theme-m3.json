{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "md-theme-m3",
  "type": "registry:theme",
  "title": "Material 3 baseline theme for shadcn/ui",
  "description": "Sets the shadcn variables from the Material 3 baseline color roles (light and dark) and a 12px radius, so shadcn/ui components match md-gb elements.",
  "cssVars": {
    "light": {
      "background": "#fef7ff",
      "foreground": "#1d1b20",
      "card": "#f7f2fa",
      "card-foreground": "#1d1b20",
      "popover": "#f3edf7",
      "popover-foreground": "#1d1b20",
      "primary": "#6750a4",
      "primary-foreground": "#fff",
      "secondary": "#e8def8",
      "secondary-foreground": "#4a4458",
      "muted": "#ece6f0",
      "muted-foreground": "#49454f",
      "accent": "#e6e0e9",
      "accent-foreground": "#1d1b20",
      "destructive": "#b3261e",
      "border": "#cac4d0",
      "input": "#79747e",
      "ring": "#6750a4",
      "chart-1": "#6750a4",
      "chart-2": "#7d5260",
      "chart-3": "#625b71",
      "chart-4": "#d0bcff",
      "chart-5": "#efb8c8",
      "sidebar": "#f7f2fa",
      "sidebar-foreground": "#1d1b20",
      "sidebar-primary": "#6750a4",
      "sidebar-primary-foreground": "#fff",
      "sidebar-accent": "#e8def8",
      "sidebar-accent-foreground": "#4a4458",
      "sidebar-border": "#cac4d0",
      "sidebar-ring": "#6750a4",
      "radius": "0.75rem"
    },
    "dark": {
      "background": "#141218",
      "foreground": "#e6e0e9",
      "card": "#1d1b20",
      "card-foreground": "#e6e0e9",
      "popover": "#211f26",
      "popover-foreground": "#e6e0e9",
      "primary": "#d0bcff",
      "primary-foreground": "#381e72",
      "secondary": "#4a4458",
      "secondary-foreground": "#e8def8",
      "muted": "#2b2930",
      "muted-foreground": "#cac4d0",
      "accent": "#36343b",
      "accent-foreground": "#e6e0e9",
      "destructive": "#f2b8b5",
      "border": "#49454f",
      "input": "#938f99",
      "ring": "#d0bcff",
      "chart-1": "#d0bcff",
      "chart-2": "#efb8c8",
      "chart-3": "#ccc2dc",
      "chart-4": "#d0bcff",
      "chart-5": "#efb8c8",
      "sidebar": "#1d1b20",
      "sidebar-foreground": "#e6e0e9",
      "sidebar-primary": "#d0bcff",
      "sidebar-primary-foreground": "#381e72",
      "sidebar-accent": "#4a4458",
      "sidebar-accent-foreground": "#e8def8",
      "sidebar-border": "#49454f",
      "sidebar-ring": "#d0bcff"
    }
  },
  "docs": "Material 3 baseline theme installed. Mapping: https://material-web.dev/3.0/about/shadcn/",
  "meta": {
    "docs": "https://material-web.dev/3.0/about/shadcn/"
  }
}
