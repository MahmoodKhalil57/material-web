{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "md-theme",
  "type": "registry:theme",
  "title": "Material Web 3.0 theme bridge",
  "description": "Loads the Material 3 styles of md-gb (labs/gb/styles/m3.css) and maps the shadcn variables to the M3 color and shape roles, so md-gb elements follow your shadcn theme in light and dark.",
  "dependencies": [
    "@material/web"
  ],
  "cssVars": {
    "light": {
      "md-sys-color-primary": "var(--primary)",
      "md-sys-color-on-primary": "var(--primary-foreground)",
      "md-sys-color-primary-container": "var(--accent)",
      "md-sys-color-on-primary-container": "var(--accent-foreground)",
      "md-sys-color-secondary": "var(--muted-foreground)",
      "md-sys-color-on-secondary": "var(--background)",
      "md-sys-color-secondary-container": "var(--secondary)",
      "md-sys-color-on-secondary-container": "var(--secondary-foreground)",
      "md-sys-color-tertiary": "var(--primary)",
      "md-sys-color-on-tertiary": "var(--primary-foreground)",
      "md-sys-color-tertiary-container": "var(--accent)",
      "md-sys-color-on-tertiary-container": "var(--accent-foreground)",
      "md-sys-color-error": "var(--destructive)",
      "md-sys-color-on-error": "var(--destructive-foreground, oklch(1 0 0))",
      "md-sys-color-error-container": "color-mix(in oklab, var(--destructive) 14%, var(--background))",
      "md-sys-color-on-error-container": "var(--destructive)",
      "md-sys-color-background": "var(--background)",
      "md-sys-color-on-background": "var(--foreground)",
      "md-sys-color-surface": "var(--background)",
      "md-sys-color-on-surface": "var(--foreground)",
      "md-sys-color-surface-variant": "var(--muted)",
      "md-sys-color-on-surface-variant": "var(--muted-foreground)",
      "md-sys-color-surface-tint": "var(--primary)",
      "md-sys-color-surface-dim": "var(--muted)",
      "md-sys-color-surface-bright": "var(--background)",
      "md-sys-color-surface-container-lowest": "var(--background)",
      "md-sys-color-surface-container-low": "var(--card)",
      "md-sys-color-surface-container": "var(--popover)",
      "md-sys-color-surface-container-high": "var(--muted)",
      "md-sys-color-surface-container-highest": "var(--accent)",
      "md-sys-color-outline": "var(--muted-foreground)",
      "md-sys-color-outline-variant": "var(--border)",
      "md-sys-color-inverse-surface": "var(--foreground)",
      "md-sys-color-inverse-on-surface": "var(--background)",
      "md-sys-color-inverse-primary": "var(--primary-foreground)",
      "md-sys-shape-corner-xs": "calc(var(--radius) * 0.4)",
      "md-sys-shape-corner-value-xs": "calc(var(--radius) * 0.4)",
      "md-sys-shape-corner-sm": "calc(var(--radius) * 0.8)",
      "md-sys-shape-corner-value-sm": "calc(var(--radius) * 0.8)",
      "md-sys-shape-corner-md": "calc(var(--radius) * 1.2)",
      "md-sys-shape-corner-value-md": "calc(var(--radius) * 1.2)",
      "md-sys-shape-corner-lg": "calc(var(--radius) * 1.6)",
      "md-sys-shape-corner-value-lg": "calc(var(--radius) * 1.6)",
      "md-sys-shape-corner-lg-increased": "calc(var(--radius) * 2)",
      "md-sys-shape-corner-value-lg-increased": "calc(var(--radius) * 2)",
      "md-sys-shape-corner-xl": "calc(var(--radius) * 2.8)",
      "md-sys-shape-corner-value-xl": "calc(var(--radius) * 2.8)",
      "md-sys-shape-corner-xl-increased": "calc(var(--radius) * 3.2)",
      "md-sys-shape-corner-value-xl-increased": "calc(var(--radius) * 3.2)",
      "md-sys-shape-corner-xxl": "calc(var(--radius) * 4.8)",
      "md-sys-shape-corner-value-xxl": "calc(var(--radius) * 4.8)"
    },
    "dark": {
      "md-sys-color-primary": "var(--primary)",
      "md-sys-color-on-primary": "var(--primary-foreground)",
      "md-sys-color-primary-container": "var(--accent)",
      "md-sys-color-on-primary-container": "var(--accent-foreground)",
      "md-sys-color-secondary": "var(--muted-foreground)",
      "md-sys-color-on-secondary": "var(--background)",
      "md-sys-color-secondary-container": "var(--secondary)",
      "md-sys-color-on-secondary-container": "var(--secondary-foreground)",
      "md-sys-color-tertiary": "var(--primary)",
      "md-sys-color-on-tertiary": "var(--primary-foreground)",
      "md-sys-color-tertiary-container": "var(--accent)",
      "md-sys-color-on-tertiary-container": "var(--accent-foreground)",
      "md-sys-color-error": "var(--destructive)",
      "md-sys-color-on-error": "var(--destructive-foreground, oklch(1 0 0))",
      "md-sys-color-error-container": "color-mix(in oklab, var(--destructive) 14%, var(--background))",
      "md-sys-color-on-error-container": "var(--destructive)",
      "md-sys-color-background": "var(--background)",
      "md-sys-color-on-background": "var(--foreground)",
      "md-sys-color-surface": "var(--background)",
      "md-sys-color-on-surface": "var(--foreground)",
      "md-sys-color-surface-variant": "var(--muted)",
      "md-sys-color-on-surface-variant": "var(--muted-foreground)",
      "md-sys-color-surface-tint": "var(--primary)",
      "md-sys-color-surface-dim": "var(--muted)",
      "md-sys-color-surface-bright": "var(--background)",
      "md-sys-color-surface-container-lowest": "var(--background)",
      "md-sys-color-surface-container-low": "var(--card)",
      "md-sys-color-surface-container": "var(--popover)",
      "md-sys-color-surface-container-high": "var(--muted)",
      "md-sys-color-surface-container-highest": "var(--accent)",
      "md-sys-color-outline": "var(--muted-foreground)",
      "md-sys-color-outline-variant": "var(--border)",
      "md-sys-color-inverse-surface": "var(--foreground)",
      "md-sys-color-inverse-on-surface": "var(--background)",
      "md-sys-color-inverse-primary": "var(--primary-foreground)",
      "md-sys-shape-corner-xs": "calc(var(--radius) * 0.4)",
      "md-sys-shape-corner-value-xs": "calc(var(--radius) * 0.4)",
      "md-sys-shape-corner-sm": "calc(var(--radius) * 0.8)",
      "md-sys-shape-corner-value-sm": "calc(var(--radius) * 0.8)",
      "md-sys-shape-corner-md": "calc(var(--radius) * 1.2)",
      "md-sys-shape-corner-value-md": "calc(var(--radius) * 1.2)",
      "md-sys-shape-corner-lg": "calc(var(--radius) * 1.6)",
      "md-sys-shape-corner-value-lg": "calc(var(--radius) * 1.6)",
      "md-sys-shape-corner-lg-increased": "calc(var(--radius) * 2)",
      "md-sys-shape-corner-value-lg-increased": "calc(var(--radius) * 2)",
      "md-sys-shape-corner-xl": "calc(var(--radius) * 2.8)",
      "md-sys-shape-corner-value-xl": "calc(var(--radius) * 2.8)",
      "md-sys-shape-corner-xl-increased": "calc(var(--radius) * 3.2)",
      "md-sys-shape-corner-value-xl-increased": "calc(var(--radius) * 3.2)",
      "md-sys-shape-corner-xxl": "calc(var(--radius) * 4.8)",
      "md-sys-shape-corner-value-xxl": "calc(var(--radius) * 4.8)"
    }
  },
  "css": {
    "@import \"@material/web/labs/gb/styles/m3.css\"": {},
    ":root": {
      "color-scheme": "light"
    },
    ".dark": {
      "color-scheme": "dark"
    }
  },
  "docs": "Material Web theme bridge installed. Read how the shadcn variables map to --md-sys-color-* at https://material-web.dev/3.0/about/shadcn/",
  "meta": {
    "docs": "https://material-web.dev/3.0/about/shadcn/"
  }
}
