{
  "name": "@material/web",
  "version": "2.5.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Material web components",
  "keywords": [
    "material",
    "material design",
    "design system",
    "components",
    "web components",
    "lit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/material-components/material-web.git"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/material-components/material-web/issues"
  },
  "homepage": "https://github.com/material-components/material-web#readme",
  "scripts": {
    "build": "node scripts/build-local.mjs",
    "test": "wtr",
    "m3:update": "node scripts/m3/update.mjs",
    "catalog:dev": "node scripts/catalog-dev.mjs",
    "catalog:walk": "node scripts/catalog-walk.mjs",
    "catalog:lighthouse": "node scripts/catalog-lighthouse.mjs",
    "catalog:pages": "node scripts/catalog-pages.mjs",
    "npm-package": "node scripts/npm-package.mjs",
    "gb:check": "node scripts/gb-check.mjs",
    "gb:baseline": "node scripts/gb-baseline.mjs",
    "gb:css-validate": "node scripts/gb-css-validate.mjs",
    "gb:size": "tsc -p scripts/tsconfig.json && node scripts/size/gb-size.js",
    "gb:size:check": "tsc -p scripts/tsconfig.json && node scripts/size/gb-size.js --check",
    "gb:size:update": "tsc -p scripts/tsconfig.json && node scripts/size/gb-size.js --update"
  },
  "type": "module",
  "customElements": "custom-elements.json",
  "files": [
    "**/*.js",
    "**/*.js.map",
    "**/*.d.ts",
    "**/*.scss",
    "**/*.css",
    "**/*.css.map",
    "custom-elements.json",
    "!web-test-runner.config.js",
    "!commitlint.config.js",
    "!**/test/**",
    "!**/*_test.*",
    "!.wireit/**",
    "!site/",
    "!scripts/",
    "!**/testing/**",
    "material-design-expressive/testing/harness.{js,js.map,d.ts}",
    "material-design-expressive/testing/transform-pseudo-classes.{js,js.map,d.ts}"
  ],
  "workspaces": [
    "site"
  ],
  "dependencies": {
    "@lit/context": "^1.1.6",
    "@material/material-color-utilities": "^0.4.0",
    "lit": "^2.8.0 || ^3.0.0",
    "safevalues": "^1.2.0",
    "tslib": "^2.4.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@lit-labs/analyzer": "^0.14.0",
    "@lit-labs/gen-manifest": "^0.3.6",
    "@lit-labs/gen-utils": "^0.3.4",
    "@rollup/plugin-multi-entry": "^6.0.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/jasmine": "^4.0.3",
    "@types/node": "^24.10.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@web/test-runner": "^0.18.2",
    "@web/test-runner-playwright": "^0.11.0",
    "axe-core": "4.10.3",
    "baseline-browser-mapping": "2.11.35",
    "css-tree": "3.1.0",
    "element-internals-polyfill": "^1.3.12",
    "jasmine": "^4.5.0",
    "lightningcss": "1.33.0",
    "playwright": "^1.49.0",
    "rollup": "^2.79.1",
    "sass": "^1.93.2",
    "sass-true": "^6.1.0",
    "typescript": "5.9.2",
    "web-features": "3.45.0",
    "web-test-runner-jasmine": "^0.0.6",
    "wireit": "^0.14.12"
  }
}
